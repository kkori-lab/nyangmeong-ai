# .env.local 키 목록. 실제 값은 디스코드로 공유한다(공개 저장소라 서버 주소·비밀값을 올리지 않는다)
# 값이 비어 있는 항목은 기능을 붙일 때 채운다. setup은 이 파일이 없으면 이 예시를 복사해 만든다

# mock: 외부 AI API를 호출하지 않는다 / real: 실제 호출
AI_MODE=mock

# Python→Java 내부 API 주소(인증 확인·대화 저장). Python은 DB에 붙지 않는다
BACKEND_BASE_URL=

# OCR 분석 제한 시간(초). Java 제한 15초보다 짧게
OCR_TIMEOUT_SEC=12

# 외부 AI API. LLM_API_KEY는 Anthropic(2026-10-28 결정), OPENAI_API_KEY는 캐릭터 이미지 생성(OpenAI GPT, 2026-10-28 결정), GOOGLE_APPLICATION_CREDENTIALS는 서비스 계정 키 파일 경로(파일은 git 제외)
LLM_API_KEY=
# LLM 모델(2026-10-28 결정 Haiku)과 호출 제한 시간(초)
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SEC=10
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# DMS MCP 주소. setup이 읽어 AI 도구에 등록한다. claude.ai dms 커넥터가 연결돼 있으면 비워도 된다
DMS_MCP_URL=
