# .env.local 키 목록. 실제 값은 디스코드로 공유한다(공개 저장소라 서버 주소·비밀값을 올리지 않는다)
# 값이 비어 있는 항목은 기능을 붙일 때 채운다. setup은 이 파일이 없으면 이 예시를 복사해 만든다

# mock: 외부 AI API를 호출하지 않는다 / real: 실제 호출
AI_MODE=mock

# DB: Python 전용 계정. 권한은 AI_CNVRS_ROOM·AI_CNVRS_MSG 읽기·쓰기, SYS_STNG 읽기만
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 인증: 백엔드 app.jwt.secret-base64와 같은 값, Java→Python 내부 호출 공유 키
JWT_SECRET_BASE64=
INTERNAL_API_KEY=

# 대화 제목·본문 암호화 키
CONVERSATION_ENC_KEY=

# 외부 AI API. GOOGLE_APPLICATION_CREDENTIALS는 서비스 계정 키 파일 경로(파일은 git 제외)
LLM_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# DMS MCP 주소. setup이 읽어 AI 도구에 등록한다. claude.ai dms 커넥터가 연결돼 있으면 비워도 된다
DMS_MCP_URL=
