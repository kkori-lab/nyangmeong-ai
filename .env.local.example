# .env.local 키 목록. 실제 값은 디스코드로 공유한다(공개 저장소라 서버 주소·비밀값을 올리지 않는다)
# 값이 비어 있는 항목은 기능을 붙일 때 채운다

# mock: 외부 AI API를 호출하지 않는다 / real: 실제 호출
AI_MODE=mock

# DB: Python 전용 계정(AI_CNVRS_ROOM·AI_CNVRS_MSG 권한만)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 인증: 백엔드와 같은 JWT 서명 키, Java↔Python 내부 호출 공유 키
JWT_SECRET=
INTERNAL_API_KEY=
JAVA_API_BASE_URL=

# 대화 제목·본문 암호화 키
CONVERSATION_ENC_KEY=

# 외부 AI API
LLM_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# DMS MCP(setup이 AI 도구에 등록한다)
DMS_MCP_URL=
