# .env.local 키 목록. 실제 값은 디스코드로 공유한다(공개 저장소라 서버 주소·비밀값을 올리지 않는다)
# 값이 비어 있는 항목은 기능을 붙일 때 채운다. setup은 이 파일이 없으면 이 예시를 복사해 만든다

# Python→Java 내부 API 주소(인증 확인·대화 저장). Python은 DB에 붙지 않는다
BACKEND_BASE_URL=
# 로그 파일 폴더. 날짜별 ai_YYYY-MM-DD.log, 30일 보관. 비우면 콘솔에만(개발 PC는 비움)
LOG_DIR=

# OCR 분석 제한 시간(초). Vision·LLM 정리를 합친 시간(FN-AIM-008-07)
OCR_TIMEOUT_SEC=15
# 검사결과지 PDF 분석 제한 시간(초). LLM_API_KEY를 쓴다(FN-HLT-005-04)
PDF_ANALYZE_TIMEOUT_SEC=30
# 메인 AI 건강분석 리포트 생성 제한 시간(초). LLM_API_KEY를 쓴다(FN-MAN-006)
HEALTH_REPORT_TIMEOUT_SEC=20
# 피부 병변 분석 제한 시간(초). LLM_API_KEY를 쓴다(docs/api/skinlesion.md)
SKIN_ANALYZE_TIMEOUT_SEC=20
# 안구 병변 분석 제한 시간(초). LLM_API_KEY를 쓴다(docs/api/eyelesion.md)
EYE_ANALYZE_TIMEOUT_SEC=20

# 외부 AI API. LLM_API_KEY는 Anthropic(2026-10-28 결정), OPENAI_API_KEY는 캐릭터 이미지 생성(OpenAI GPT, 2026-10-28 결정), GOOGLE_VISION_API_KEY는 영수증 OCR(Google Vision API 키)
LLM_API_KEY=
# LLM 모델(2026-10-28 결정 Haiku)과 호출 제한 시간(초)
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SEC=10
# 프로그래밍식 도구 호출 시험(2026-11-26). true면 읽기 도구를 코드 실행 안에서 부른다. 기본 false
LLM_PTC=false
# 에이전트 이어 가기(agent-continue) 토큰 서명 키(2026-11-26). 비우면 프로세스마다 무작위 키로 켜짐(2026-11-27). 재시작 때 진행 중 토큰만 무효, 서버 여러 대면 같은 값
AGENT_STATE_KEY=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# DMS MCP 주소. setup이 읽어 AI 도구에 등록한다. claude.ai dms 커넥터가 연결돼 있으면 비워도 된다
DMS_MCP_URL=
